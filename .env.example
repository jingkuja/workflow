# 仅供本地开发。部署前必须替换密码和所有 dev-* Token。
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
PUBLIC_BASE_URL=http://localhost:8080
INTERNAL_API_BASE_URL=http://workflow-api:8000
PROBE_DATA_DIR=/data/probes
FILE_DATA_DIR=/data/files
DATABASE_URL=postgresql+psycopg://workflow:workflow-dev-password@postgres:5432/workflow
POSTGRES_DB=workflow
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow-dev-password
COMPANY_ID=default
DISK_WARN_PERCENT=20
DISK_REJECT_PERCENT=10
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
NOTIFICATION_SEND_ENABLED=false
WORKDAY_START_HOUR=9
WORKDAY_END_HOUR=18
WEEKLY_TARGET_MIN=35
WEEKLY_TARGET_MAX=40
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# 部署公网域名时设置 PUBLIC_BASE_URL 即会自动加入 MCP Host/Origin 白名单；
# 若前置网关改写了 Host，再将该 Host 显式追加到 MCP_ALLOWED_HOSTS。

MCP_BOSS_NAME=老板测试
MCP_BOSS_TOKEN=dev-boss-token-change-me
FILE_UPLOAD_TOKEN=dev-file-upload-token-change-me
MCP_BOSS_WECOM_USERID=
MCP_EMPLOYEES_JSON='[{"name":"员工测试","token":"dev-employee-token-change-me","wecom_userid":"","active":true}]'

MAX_TOPIC_DOCUMENT_BYTES=10485760
MAX_SCRIPT_DOCUMENT_BYTES=104857600
MAX_VIDEO_BYTES=104857600
FILE_UPLOAD_TTL_HOURS=24

# 默认禁止真实发送，避免误发群消息。完成企业微信联调时显式改为 true。
T0_ALLOW_WECOM_SEND=false
WECOM_GROUP_WEBHOOK_URL=
